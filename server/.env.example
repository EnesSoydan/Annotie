# server/.env olarak kopyalayın; docker compose bu dosyayı otomatik okur.

# Kimlik doğrulama (önerilen): Supabase proje URL'si ve anon/publishable key.
# service_role anahtarını ASLA buraya koymayın.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Yalnızca güvenilir LAN/test: kimlik doğrulamasız açık mod.
# RELAY_INSECURE_OPEN=1

# 127.0.0.1 (varsayılan): yalnızca reverse proxy üzerinden erişim.
# 0.0.0.0: aynı ağdaki istemciler doğrudan ws://<sunucu-ip>:8765/ws ile bağlanır.
# RELAY_BIND_ADDR=0.0.0.0

# İsteğe bağlı sınırlar
# RELAY_MAX_MESSAGE_BYTES=2097152
# RELAY_RATE_PER_SEC=50
# RELAY_RATE_BURST=200
